<% if notice.present? %>
  <p style="color: #0a7a32;"><%= notice %></p>
<% end %>
<% if alert.present? %>
  <p style="color: #b00020;"><%= alert %></p>
<% end %>

<h1>メモ一覧</h1>
<p>Model を Controller 経由で読み書きする最小 CRUD です（一覧・作成・削除）。</p>

<h2>新規作成</h2>
<%= form_with model: @memo do |f| %>
  <p>
    <%= f.label :title, "タイトル" %><br>
    <%= f.text_field :title, required: true %>
  </p>
  <p>
    <%= f.label :body, "本文" %><br>
    <%= f.text_area :body, rows: 3, style: "width: min(100%, 20rem);" %>
  </p>
  <p><%= f.submit "作成する" %></p>
<% end %>

<h2>一覧 (<%= @memos.size %>件)</h2>
<% if @memos.empty? %>
  <p>まだメモがありません。</p>
<% else %>
  <ul>
    <% @memos.each do |memo| %>
      <li style="margin-bottom: 0.75rem;">
        <strong><%= memo.title %></strong>
        <% if memo.body.present? %>
          <div><%= simple_format(memo.body) %></div>
        <% end %>
        <%= button_to "削除", memo_path(memo), method: :delete, form: { style: "display:inline;" } %>
      </li>
    <% end %>
  </ul>
<% end %>
